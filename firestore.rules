        && (source.mode == 'meeting'
          ? (data.segmentId == null && source.absentUnits > 0 && source.justifiedUnits == 0)
          : (data.segmentId in session.segmentIds
            && get(attendanceRosterPath(courseId, data.sessionId, data.rosterEntryId)).data.segments[data.segmentId].mark == 'absent'
            && get(attendanceRosterPath(courseId, data.sessionId, data.rosterEntryId)).data.segments[data.segmentId].absentUnits > 0
            && get(attendanceRosterPath(courseId, data.sessionId, data.rosterEntryId)).data.segments[data.segmentId].justifiedUnits == 0));
    }
    function canDecideAttendanceRequest(courseId, before, after) {
      let session = getAfter(attendanceSessionPath(courseId, before.sessionId)).data;
      let mark = getAfter(attendanceRosterPath(courseId, before.sessionId, before.rosterEntryId)).data;
      let units = before.segmentId == null ? mark : mark.segments[before.segmentId];
      return ownsExistingCourse(courseId) && before.status == 'pending'
