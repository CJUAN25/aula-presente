rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function emailVerified() {
      return signedIn()
        && request.auth.token.get('email_verified', false) == true;
    }

    function validStudentCode(code) {
      return code == null
        || (code is string && code.size() >= 1 && code.size() <= 40);
    }

    function validRoles(roles) {
      return roles is list
        && roles.size() >= 1
        && roles.size() <= 3
        && roles.hasOnly(['student', 'teacher', 'admin'])
        && (
          roles.size() == 1
          || (roles.size() == 2 && roles[0] != roles[1])
          || (
            roles.size() == 3
            && roles[0] != roles[1]
            && roles[0] != roles[2]
            && roles[1] != roles[2]
          )
        );
    }

    function validProfileShape(profile) {
      return profile.keys().hasAll([
          'name',
          'email',
          'studentCode',
          'roles'
        ])
        && profile.keys().hasOnly([
          'name',
          'email',
          'studentCode',
          'roles'
        ])
        && profile.name is string
        && profile.name.size() >= 1
        && profile.name.size() <= 100
        && profile.email is string
        && profile.email.size() >= 3
        && profile.email.size() <= 254
        && validStudentCode(profile.studentCode)
        && validRoles(profile.roles);
    }

    function validTeacherAccessRequestShape(accessRequest) {
      return accessRequest.keys().hasAll([
          'uid',
          'name',
          'email',
          'studentCode',
          'status',
          'createdAt',
          'decidedBy',
          'decidedAt',
          'rejectionReason'
        ])
        && accessRequest.keys().hasOnly([
          'uid',
          'name',
          'email',
          'studentCode',
          'status',
          'createdAt',
          'decidedBy',
          'decidedAt',
          'rejectionReason'
        ])
        && accessRequest.uid is string
        && accessRequest.name is string
        && accessRequest.name.size() >= 1
        && accessRequest.name.size() <= 100
        && accessRequest.email is string
        && accessRequest.email.size() >= 3
        && accessRequest.email.size() <= 254
        && validStudentCode(accessRequest.studentCode)
        && accessRequest.status in ['pending', 'approved', 'rejected']
        && accessRequest.createdAt is timestamp
        && (accessRequest.decidedBy == null || accessRequest.decidedBy is string)
        && (accessRequest.decidedAt == null || accessRequest.decidedAt is timestamp)
        && (
          accessRequest.rejectionReason == null
          || (
            accessRequest.rejectionReason is string
            && accessRequest.rejectionReason.size() >= 1
            && accessRequest.rejectionReason.size() <= 500
          )
        );
    }

    function validDemoRecord(record) {
      return record.keys().hasAll([
          'title',
          'description',
          'createdAt',
          'updatedAt'
        ])
        && record.keys().hasOnly([
          'title',
          'description',
          'createdAt',
          'updatedAt'
        ])
        && record.title is string
        && record.title.size() >= 1
        && record.title.size() <= 120
        && record.description is string
        && record.description.size() <= 1000
        && record.createdAt is timestamp
        && record.updatedAt is timestamp;
    }

    function profileHasAdminRole(profile) {
      return profile.roles is list && profile.roles.hasAny(['admin']);
    }

    function userHasAdminRole(uid) {
      let profilePath = /databases/$(database)/documents/users/$(uid);
      return exists(profilePath)
        && profileHasAdminRole(get(profilePath).data);
    }

    function verifiedAdmin() {
      return emailVerified() && userHasAdminRole(request.auth.uid);
    }

    function isPendingTeacherAccessRequest(accessRequest, uid) {
      return validTeacherAccessRequestShape(accessRequest)
        && accessRequest.uid == uid
        && accessRequest.status == 'pending';
    }

    function adminCanReviewPendingRequest(uid) {
      let requestPath = /databases/$(database)/documents/teacher_access_requests/$(uid);
      return verifiedAdmin()
        && exists(requestPath)
        && isPendingTeacherAccessRequest(get(requestPath).data, uid);
    }

    function adminCanGetPendingRequesterProfile(uid) {
      return adminCanReviewPendingRequest(uid);
    }

    function matchingProfileSnapshot(accessRequest, uid, profile) {
      return accessRequest.uid == uid
        && accessRequest.name == profile.name
        && accessRequest.email == profile.email
        && accessRequest.studentCode == profile.studentCode;
    }

    function profileCanCreateTeacherAccessRequest(uid, accessRequest) {
      let profilePath = /databases/$(database)/documents/users/$(uid);
      let profile = get(profilePath).data;
      return validProfileShape(profile)
        && profile.email == request.auth.token.email
        && profile.roles.hasAny(['teacher']) == false
        && matchingProfileSnapshot(accessRequest, uid, profile);
    }

    function canCreateTeacherAccessRequest(uid) {
      let profilePath = /databases/$(database)/documents/users/$(uid);
      return ownsUser(uid)
        && emailVerified()
        && exists(profilePath)
        && request.resource.data.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.decidedBy == null
        && request.resource.data.decidedAt == null
        && request.resource.data.rejectionReason == null
        && validTeacherAccessRequestShape(request.resource.data)
        && profileCanCreateTeacherAccessRequest(uid, request.resource.data);
    }

    function canApproveWithAtomicTeacherGrant(uid) {
      let profilePath = /databases/$(database)/documents/users/$(uid);
      let currentProfile = get(profilePath).data;
      let profileAfter = getAfter(profilePath).data;
      return exists(profilePath)
        && validProfileShape(currentProfile)
        && validProfileShape(profileAfter)
        && currentProfile.roles.hasAny(['teacher']) == false
        && profileAfter.roles.hasAny(['teacher'])
        && profileAfter.roles.size() == currentProfile.roles.size() + 1
        && profileAfter.roles.hasAll(currentProfile.roles)
        && request.resource.data.uid == uid
        && request.resource.data.name == profileAfter.name
        && request.resource.data.email == profileAfter.email
        && request.resource.data.studentCode == profileAfter.studentCode;
    }

    function canDecideTeacherAccessRequest(uid) {
      return verifiedAdmin()
        && request.auth.uid != uid
        && validTeacherAccessRequestShape(resource.data)
        && validTeacherAccessRequestShape(request.resource.data)
        && resource.data.uid == uid
        && resource.data.status == 'pending'
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.name == resource.data.name
        && request.resource.data.email == resource.data.email
        && request.resource.data.studentCode == resource.data.studentCode
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.decidedBy == request.auth.uid
        && request.resource.data.decidedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'decidedBy', 'decidedAt', 'rejectionReason'])
        && (
          (
            request.resource.data.status == 'approved'
            && request.resource.data.rejectionReason == null
            && canApproveWithAtomicTeacherGrant(uid)
          )
          || (
            request.resource.data.status == 'rejected'
            && request.resource.data.rejectionReason is string
            && request.resource.data.rejectionReason.size() >= 1
            && request.resource.data.rejectionReason.size() <= 500
          )
        );
    }

    function adminGrantsTeacherRoleAtomically(uid) {
      let accessRequestPath = /databases/$(database)/documents/teacher_access_requests/$(uid);
      let accessRequestAfter = getAfter(accessRequestPath).data;
      return verifiedAdmin()
        && request.auth.uid != uid
        && validProfileShape(resource.data)
        && validProfileShape(request.resource.data)
        && resource.data.roles.hasAny(['teacher']) == false
        && request.resource.data.roles.hasAny(['teacher'])
        && request.resource.data.roles.size() == resource.data.roles.size() + 1
        && request.resource.data.roles.hasAll(resource.data.roles)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['roles'])
        && exists(accessRequestPath)
        && validTeacherAccessRequestShape(accessRequestAfter)
        && accessRequestAfter.uid == uid
        && accessRequestAfter.status == 'approved'
        && accessRequestAfter.decidedBy == request.auth.uid
        && accessRequestAfter.decidedAt == request.time
        && matchingProfileSnapshot(
          accessRequestAfter,
          uid,
          request.resource.data
        );
    }

    // Course access is restricted to verified users whose own profile is valid
    // and currently contains the trusted teacher role.
    function validCourseTeacherProfile(uid) {
      let profilePath = /databases/$(database)/documents/users/$(uid);
      let profile = get(profilePath).data;
      // Reject a student-only profile before paying for the full teacher
      // shape. The same shape/email checks still gate every teacher access.
      return profile.roles is list
        && profile.roles.hasAny(['teacher'])
        && validProfileShape(profile)
        && profile.email == request.auth.token.email;
    }

    function verifiedTeacher() {
      return emailVerified()
        && validCourseTeacherProfile(request.auth.uid);
    }

    function validCourseStudentProfile(uid) {
      let profilePath = /databases/$(database)/documents/users/$(uid);
      let profile = get(profilePath).data;
      return validProfileShape(profile)
        && profile.email == request.auth.token.email
        && profile.roles.hasAny(['student']);
    }

    function verifiedStudent() {
      return emailVerified()
        && validCourseStudentProfile(request.auth.uid);
    }

    function directoryPath(email) {
      return /databases/$(database)/documents/student_directory/$(email);
    }

    function enrollmentPath(courseId, studentUid) {
      return /databases/$(database)/documents/courses/$(courseId)/enrollments/$(studentUid);
    }

    function validDirectoryShape(entry) {
      return entry.keys().hasAll(['uid', 'name', 'email', 'studentCode', 'updatedAt'])
        && entry.keys().hasOnly(['uid', 'name', 'email', 'studentCode', 'updatedAt'])
        && entry.uid is string
        && entry.name is string
        && entry.name.size() >= 1
        && entry.name.size() <= 100
        && entry.email is string
        && entry.email.size() >= 3
        && entry.email.size() <= 254
        && validStudentCode(entry.studentCode)
        && entry.updatedAt is timestamp;
    }

    function directoryMatchesCurrentProfile(entry) {
      let profilePath = /databases/$(database)/documents/users/$(entry.uid);
      let profile = get(profilePath).data;
      return exists(profilePath)
        && validDirectoryShape(entry)
        && validProfileShape(profile)
        && profile.roles.hasAny(['student'])
        && entry.name == profile.name
        && entry.email == profile.email
        && entry.studentCode == profile.studentCode;
    }

    function canWriteDirectory(email, entry) {
      // The current-profile check validates the student role and profile email.
      // Check cheap request identity first to avoid revalidating the same
      // profile through both verifiedStudent() and directoryMatchesCurrentProfile().
      return emailVerified()
        && email == request.auth.token.email
        && entry.uid == request.auth.uid
        && entry.email == email
        && entry.updatedAt == request.time
        && directoryMatchesCurrentProfile(entry);
    }

    function validEnrollmentShape(enrollment) {
      return enrollment.keys().hasAll([
          'studentUid', 'ownerUid', 'name', 'email', 'studentCode',
          'subject', 'group', 'period', 'status', 'createdAt'
        ])
        && enrollment.keys().hasOnly([
          'studentUid', 'ownerUid', 'name', 'email', 'studentCode',
          'subject', 'group', 'period', 'status', 'createdAt',
          'lastStatusEventId', 'lastStatusChangedAt',
          'rosterEntryId', 'effectiveStartDate'
        ])
        && enrollment.studentUid is string
        && enrollment.ownerUid is string
        && enrollment.name is string
        && enrollment.name.size() >= 1
        && enrollment.name.size() <= 100
        && enrollment.email is string
        && enrollment.email.size() >= 3
        && enrollment.email.size() <= 254
        && validStudentCode(enrollment.studentCode)
        && nonBlankCourseText(enrollment.subject, 120)
        && nonBlankCourseText(enrollment.group, 40)
        && nonBlankCourseText(enrollment.period, 32)
        && enrollment.status in ['active', 'withdrawn']
        && enrollment.createdAt is timestamp
        && (
          (
            !('rosterEntryId' in enrollment)
            && !('effectiveStartDate' in enrollment)
          )
          || (
            enrollment.rosterEntryId is string
            && enrollment.rosterEntryId == enrollment.email
            && enrollment.effectiveStartDate is timestamp
            && enrollment.effectiveStartDate.date()
              == enrollment.effectiveStartDate
          )
        )
        && (
          (
            !('lastStatusEventId' in enrollment)
            && !('lastStatusChangedAt' in enrollment)
          )
          || (
            enrollment.lastStatusEventId is string
            && enrollment.lastStatusEventId.size() >= 1
            && enrollment.lastStatusEventId.size() <= 128
            && enrollment.lastStatusChangedAt is timestamp
          )
        );
    }

    function validEnrollmentStatusEvent(event) {
      return event.keys().hasAll([
          'fromStatus', 'toStatus', 'changedAt', 'changedBy'
        ])
        && (
          event.keys().hasOnly([
            'fromStatus', 'toStatus', 'changedAt', 'changedBy'
          ])
          || (
            event.keys().hasOnly([
              'fromStatus', 'toStatus', 'effectiveDate',
              'changedAt', 'changedBy'
            ])
            && event.effectiveDate is timestamp
            && event.effectiveDate.date() == event.effectiveDate
          )
        )
        && event.fromStatus in ['active', 'withdrawn']
        && event.toStatus in ['active', 'withdrawn']
        && event.fromStatus != event.toStatus
        && event.changedAt is timestamp
        && event.changedBy is string;
    }

    function bogotaToday() {
      // America/Bogota is UTC-5 and does not observe daylight saving time.
      return (request.time - duration.value(5, 'h')).date();
    }

    function validEffectiveDateForCourse(effectiveDate, course, allowFutureStart) {
      return effectiveDate is timestamp
        && effectiveDate.date() == effectiveDate
        && effectiveDate >= course.startDate
        && effectiveDate <= course.endDate
        && (
          effectiveDate <= bogotaToday()
          || (
            allowFutureStart
            && course.startDate > bogotaToday()
            && effectiveDate == course.startDate
          )
        );
    }

    function validPendingWithdrawalDate(effectiveDate, pending, course) {
      return effectiveDate is timestamp
        && effectiveDate.date() == effectiveDate
        && effectiveDate <= bogotaToday()
        && effectiveDate <= course.endDate
        && effectiveDate >= (pending.authorizedAt - duration.value(5, 'h')).date()
        && (
          pending.effectiveStartDate > bogotaToday()
          || effectiveDate >= previousPendingEffectiveDate(
            pending.courseId,
            pending.email,
            pending
          )
        );
    }

    function previousEnrollmentEffectiveDate(courseId, studentUid, enrollment) {
      return ('lastStatusEventId' in enrollment)
        ? previousEnrollmentEventEffectiveDate(
            courseId,
            studentUid,
            enrollment.lastStatusEventId
          )
        : (
            ('effectiveStartDate' in enrollment)
              ? enrollment.effectiveStartDate
              : (enrollment.createdAt - duration.value(5, 'h')).date()
          );
    }

    function previousEnrollmentEventEffectiveDate(courseId, studentUid, eventId) {
      let eventPath = /databases/$(database)/documents/courses/$(courseId)/enrollments/$(studentUid)/status_events/$(eventId);
      let event = get(eventPath).data;
      return ('effectiveDate' in event)
        ? event.effectiveDate
        : (event.changedAt - duration.value(5, 'h')).date();
    }

    function validEnrollmentStatusDate(
      courseId,
      studentUid,
      effectiveDate,
      nextStatus,
      enrollment,
      course
    ) {
      return nextStatus == 'withdrawn'
          && ('effectiveStartDate' in enrollment)
          && enrollment.effectiveStartDate > bogotaToday()
        ? (
            effectiveDate is timestamp
            && effectiveDate.date() == effectiveDate
            && effectiveDate <= bogotaToday()
            && effectiveDate <= course.endDate
            && effectiveDate
              >= (enrollment.createdAt - duration.value(5, 'h')).date()
          )
        : (
            validEffectiveDateForCourse(
              effectiveDate,
              course,
              nextStatus == 'active'
            )
            && effectiveDate >= previousEnrollmentEffectiveDate(
              courseId,
              studentUid,
              enrollment
            )
          );
    }

    function validPendingEnrollmentShape(courseId, emailExact, pending) {
      return pending.keys().hasAll([
          'courseId', 'ownerUid', 'subject', 'group', 'period',
          'email', 'studentCode', 'name', 'status', 'effectiveStartDate',
          'rosterEntryId', 'studentUid', 'authorizedAt', 'linkedAt',
          'createdAt', 'updatedAt', 'lastEventId', 'lastStatusChangedAt'
        ])
        && pending.keys().hasOnly([
          'courseId', 'ownerUid', 'subject', 'group', 'period',
          'email', 'studentCode', 'name', 'status', 'effectiveStartDate',
          'rosterEntryId', 'studentUid', 'authorizedAt', 'linkedAt',
          'createdAt', 'updatedAt', 'lastEventId', 'lastStatusChangedAt'
        ])
        && pending.courseId == courseId
        && pending.ownerUid is string
        && nonBlankCourseText(pending.subject, 120)
        && nonBlankCourseText(pending.group, 40)
        && nonBlankCourseText(pending.period, 32)
        && pending.email is string
        && pending.email.size() >= 3
        && pending.email.size() <= 254
        && pending.email == emailExact
        && pending.studentCode is string
        && pending.studentCode.size() >= 1
        && pending.studentCode.size() <= 40
        && pending.name is string
        && pending.name.size() >= 1
        && pending.name.size() <= 100
        && pending.status in ['pending', 'linked', 'withdrawn']
        && pending.effectiveStartDate is timestamp
        && pending.effectiveStartDate.date() == pending.effectiveStartDate
        && pending.rosterEntryId is string
        && pending.rosterEntryId == emailExact
        && (
          (
            pending.status in ['pending', 'withdrawn']
            && pending.studentUid == null
            && pending.linkedAt == null
          )
          || (
            pending.status == 'linked'
            && pending.studentUid is string
            && pending.studentUid.size() >= 1
            && pending.linkedAt is timestamp
          )
        )
        && pending.authorizedAt is timestamp
        && pending.createdAt is timestamp
        && pending.updatedAt is timestamp
        && (
          (
            pending.lastEventId == null
            && pending.lastStatusChangedAt == null
          )
          || (
            pending.lastEventId is string
            && pending.lastEventId.size() >= 1
            && pending.lastEventId.size() <= 128
            && pending.lastStatusChangedAt is timestamp
          )
        );
    }

    function validPendingStatusEvent(event) {
      return event.keys().hasAll([
          'fromStatus', 'toStatus', 'effectiveDate', 'changedAt', 'changedBy'
        ])
        && event.keys().hasOnly([
          'fromStatus', 'toStatus', 'effectiveDate', 'changedAt', 'changedBy',
          'fromEffectiveStartDate'
        ])
        && event.fromStatus in ['pending', 'linked', 'withdrawn']
        && event.toStatus in ['pending', 'linked', 'withdrawn']
        && event.fromStatus != event.toStatus
        && event.effectiveDate is timestamp
        && event.effectiveDate.date() == event.effectiveDate
        && (!event.keys().hasAny(['fromEffectiveStartDate'])
          || (event.fromEffectiveStartDate is timestamp
            && event.fromEffectiveStartDate.date() == event.fromEffectiveStartDate))
        && event.changedAt is timestamp
        && event.changedBy is string;
    }

    function pendingEnrollmentPath(courseId, emailExact) {
      return /databases/$(database)/documents/courses/$(courseId)/pending_enrollments/$(emailExact);
    }

    function pendingStatusEventPath(courseId, emailExact, eventId) {
      return /databases/$(database)/documents/courses/$(courseId)/pending_enrollments/$(emailExact)/status_events/$(eventId);
    }

    function pendingStudentMatchesAuth(pending) {
      let profilePath = /databases/$(database)/documents/users/$(request.auth.uid);
      let profile = get(profilePath).data;
      return verifiedStudent()
        && profile.studentCode is string
        && pending.email == request.auth.token.email
        && pending.studentCode == profile.studentCode
        && pending.status == 'pending';
    }

    function previousPendingEffectiveDate(courseId, emailExact, pending) {
      return (pending.lastEventId is string)
        ? previousPendingEventEffectiveDate(
            courseId,
            emailExact,
            pending.lastEventId
          )
        : pending.effectiveStartDate;
    }

    function previousPendingEventEffectiveDate(courseId, emailExact, eventId) {
      let eventPath = pendingStatusEventPath(courseId, emailExact, eventId);
      return get(eventPath).data.effectiveDate;
    }

    function pendingMatchesEnrollment(pending, enrollment, studentUid) {
      return enrollment.studentUid == studentUid
        && enrollment.ownerUid == pending.ownerUid
        && enrollment.email == pending.email
        && enrollment.studentCode == pending.studentCode
        && enrollment.subject == pending.subject
        && enrollment.group == pending.group
        && enrollment.period == pending.period
        && enrollment.status == 'active'
        && (
          (
            'rosterEntryId' in enrollment
            && 'effectiveStartDate' in enrollment
            && enrollment.rosterEntryId == pending.rosterEntryId
            && enrollment.effectiveStartDate == pending.effectiveStartDate
          )
          || (
            !('rosterEntryId' in enrollment)
            && !('effectiveStartDate' in enrollment)
          )
        );
    }

    // New enrollment documents reconciled from a pending roster snapshot are
    // derived from that already-validated snapshot. Keep the exact key set
    // check here; the identity and value checks below bind every copied field
    // to the immutable pending authorization.
    function validEnrollmentFromPendingShape(enrollment) {
      return enrollment.keys().hasAll([
          'studentUid', 'ownerUid', 'name', 'email', 'studentCode',
          'subject', 'group', 'period', 'status', 'createdAt',
          'rosterEntryId', 'effectiveStartDate'
        ])
        && enrollment.keys().hasOnly([
          'studentUid', 'ownerUid', 'name', 'email', 'studentCode',
          'subject', 'group', 'period', 'status', 'createdAt',
          'rosterEntryId', 'effectiveStartDate'
        ])
        && enrollment.name is string
        && enrollment.name.size() >= 1
        && enrollment.name.size() <= 100;
    }

    function pendingEnrollmentLinkMatches(courseId, enrollment) {
      let pendingPath = pendingEnrollmentPath(courseId, enrollment.email);
      let pendingBefore = get(pendingPath).data;
      let pendingAfter = getAfter(pendingPath).data;
      return pendingBefore.status == 'pending'
        && pendingBefore.courseId == courseId
        && pendingBefore.ownerUid == request.auth.uid
        && pendingMatchesEnrollment(
          pendingBefore,
          enrollment,
          enrollment.studentUid
        )
        && existsAfter(pendingPath)
        && pendingAfter.status == 'linked'
        && pendingAfter.studentUid == enrollment.studentUid
        && pendingAfter.linkedAt == request.time
        && pendingAfter.rosterEntryId == enrollment.rosterEntryId
        && pendingAfter.effectiveStartDate == enrollment.effectiveStartDate;
    }

    function canCreateEnrollmentFromOwnPending(courseId, studentUid) {
      let enrollment = request.resource.data;
      let coursePath = /databases/$(database)/documents/courses/$(courseId);
      let course = get(coursePath).data;
      let pendingPath = pendingEnrollmentPath(courseId, enrollment.email);
      let pending = get(pendingPath).data;
      let pendingAfter = getAfter(pendingPath).data;
      let profilePath = /databases/$(database)/documents/users/$(studentUid);
      let profile = get(profilePath).data;
      return verifiedStudent()
        && request.auth.uid == studentUid
        && profile.studentCode is string
        && validEnrollmentFromPendingShape(enrollment)
        && enrollment.status == 'active'
        && enrollment.studentUid == studentUid
        && enrollment.email == request.auth.token.email
        && enrollment.studentCode == profile.studentCode
        && enrollment.createdAt == request.time
        && 'rosterEntryId' in enrollment
        && 'effectiveStartDate' in enrollment
        && enrollment.rosterEntryId == enrollment.email
        && exists(coursePath)
        && enrollment.ownerUid == course.ownerUid
        && enrollment.subject == course.subject
        && enrollment.group == course.group
        && enrollment.period == course.period
        && exists(pendingPath)
        && pending.courseId == courseId
        && pending.email == enrollment.email
        && pending.rosterEntryId == enrollment.rosterEntryId
        && pending.status == 'pending'
        && pending.studentUid == null
        && pending.ownerUid == enrollment.ownerUid
        && pending.email == enrollment.email
        && pending.studentCode == profile.studentCode
        && pending.subject == enrollment.subject
        && pending.group == enrollment.group
        && pending.period == enrollment.period
        && pending.rosterEntryId == enrollment.rosterEntryId
        && pending.effectiveStartDate == enrollment.effectiveStartDate
        && validEffectiveDateForCourse(
          enrollment.effectiveStartDate,
          course,
          true
        )
        && existsAfter(pendingPath)
        && pendingAfter.status == 'linked'
        && pendingAfter.studentUid == studentUid
        && pendingAfter.linkedAt == request.time
        && pendingAfter.lastEventId == 'link';
    }

    function canCreatePendingEnrollment(courseId, emailExact) {
      let pending = request.resource.data;
      let coursePath = /databases/$(database)/documents/courses/$(courseId);
      let course = get(coursePath).data;
      let entryPath = directoryPath(emailExact);
      return ownsExistingCourse(courseId)
        && exists(coursePath)
        && validPendingEnrollmentShape(courseId, emailExact, pending)
        && pending.status == 'pending'
        && pending.ownerUid == request.auth.uid
        && pending.subject == course.subject
        && pending.group == course.group
        && pending.period == course.period
        && pending.authorizedAt == request.time
        && pending.createdAt == request.time
        && pending.updatedAt == request.time
        && pending.studentUid == null
        && pending.linkedAt == null
        && pending.lastEventId == null
        && pending.lastStatusChangedAt == null
        && validEffectiveDateForCourse(
          pending.effectiveStartDate,
          course,
          true
        )
        && !exists(entryPath);
    }

    function canLinkPendingEnrollmentAsStudent(
      courseId,
      emailExact,
      before,
      after,
      course
    ) {
      let enrollmentPathValue = enrollmentPath(courseId, request.auth.uid);
      return pendingStudentMatchesAuth(before)
        && before.status == 'pending'
        && before.courseId == courseId
        && before.email == emailExact
        && before.rosterEntryId == emailExact
        && after.status == 'linked'
        && after.studentUid == request.auth.uid
        && after.linkedAt == request.time
        && after.effectiveStartDate == before.effectiveStartDate
        && after.lastEventId == 'link'
        && before.ownerUid == course.ownerUid
        && before.subject == course.subject
        && before.group == course.group
        && before.period == course.period
        && existsAfter(enrollmentPathValue)
        && pendingLinkHasCanonicalEnrollmentForUid(
          courseId,
          after,
          request.auth.uid
        );
    }

    function pendingLinkHasCanonicalEnrollmentForUid(
      courseId,
      pendingAfter,
      studentUid
    ) {
      let enrollmentPathValue = enrollmentPath(courseId, studentUid);
      return existsAfter(enrollmentPathValue)
        && (!exists(enrollmentPathValue)
          || pendingMatchesEnrollment(
            pendingAfter,
            getAfter(enrollmentPathValue).data,
            studentUid
          ));
    }

    function pendingLinkHasCanonicalEnrollment(courseId, pendingAfter) {
      return pendingAfter.studentUid is string
        && pendingAfter.linkedAt == request.time
        && pendingLinkHasCanonicalEnrollmentForUid(
          courseId,
          pendingAfter,
          pendingAfter.studentUid
        );
    }

    function teacherCanChangePendingEnrollment(
      courseId,
      emailExact,
      before,
      after,
      event,
      course
    ) {
      return request.auth.uid == before.ownerUid
        && course.ownerUid == before.ownerUid
        && (
          (
            before.status == 'pending'
            && after.status == 'withdrawn'
            && after.studentUid == null
            && after.linkedAt == null
            && after.effectiveStartDate == before.effectiveStartDate
            && validPendingWithdrawalDate(event.effectiveDate, before, course)
            && verifiedTeacher()
          )
          || (
            before.status == 'withdrawn'
            && after.status == 'pending'
            && after.studentUid == null
            && after.linkedAt == null
            && after.effectiveStartDate == event.effectiveDate
            && event.effectiveDate >= previousPendingEffectiveDate(
              courseId,
              emailExact,
              before
            )
            && validEffectiveDateForCourse(event.effectiveDate, course, true)
            && verifiedTeacher()
          )
          || (
            before.status == 'pending'
            && after.status == 'linked'
            && after.effectiveStartDate == before.effectiveStartDate
            && after.lastEventId == 'link'
            && pendingLinkHasCanonicalEnrollment(courseId, after)
            && event.effectiveDate == before.effectiveStartDate
            && event.effectiveDate >= previousPendingEffectiveDate(
              courseId,
              emailExact,
              before
            )
            && validEffectiveDateForCourse(event.effectiveDate, course, true)
            && verifiedTeacher()
          )
        );
    }

    function canChangePendingEnrollment(courseId, emailExact) {
      let before = resource.data;
      let after = request.resource.data;
      let eventPath = pendingStatusEventPath(
        courseId,
        emailExact,
        after.lastEventId
      );
      let event = getAfter(eventPath).data;
      let coursePath = /databases/$(database)/documents/courses/$(courseId);
      let course = get(coursePath).data;
      return after.lastEventId is string
        && !exists(eventPath)
        && existsAfter(eventPath)
        && before.courseId == courseId
        && before.email == emailExact
        && before.rosterEntryId == emailExact
        && after.lastEventId.size() >= 1
        && after.lastEventId.size() <= 128
        && before.status != after.status
        && after.diff(before).affectedKeys().hasOnly([
          'status', 'effectiveStartDate', 'studentUid', 'linkedAt',
          'updatedAt', 'lastEventId', 'lastStatusChangedAt'
        ])
        && validPendingStatusEvent(event)
        && event.keys().hasAny(['fromEffectiveStartDate'])
        && event.fromEffectiveStartDate == before.effectiveStartDate
        && event.changedAt == request.time
        && event.changedBy == request.auth.uid
        && event.fromStatus == before.status
        && event.toStatus == after.status
        && after.lastStatusChangedAt == request.time
        && after.updatedAt == request.time
        && exists(coursePath)
        && (request.auth.uid == before.ownerUid
          ? teacherCanChangePendingEnrollment(
              courseId,
              emailExact,
              before,
              after,
              event,
              course
            )
          : canLinkPendingEnrollmentAsStudent(
              courseId,
              emailExact,
              before,
              after,
              course
            ));
    }

    function canCreatePendingStatusEvent(courseId, emailExact, eventId) {
      let pendingPath = pendingEnrollmentPath(courseId, emailExact);
      let pendingBefore = get(pendingPath).data;
      let pendingAfter = getAfter(pendingPath).data;
      let eventPath = pendingStatusEventPath(courseId, emailExact, eventId);
      let event = request.resource.data;
      // The paired pending update owns the authorization and transition checks.
      // This side cheaply requires its exact marker/timestamps, so an event
      // cannot be created alone or attached to a different state change.
      return exists(pendingPath)
        && existsAfter(pendingPath)
        && pendingAfter.lastEventId == eventId
        && pendingAfter.status == event.toStatus
        && pendingAfter.lastStatusChangedAt == request.time
        && pendingAfter.updatedAt == request.time
        && !exists(eventPath)
        && validPendingStatusEvent(event)
        && event.keys().hasAny(['fromEffectiveStartDate'])
        && event.fromEffectiveStartDate == pendingBefore.effectiveStartDate
        && event.changedAt == request.time
        && event.changedBy == request.auth.uid
        && event.fromStatus == pendingBefore.status
        && event.toStatus == pendingAfter.status;
    }

    function canChangeEnrollmentStatus(courseId, studentUid) {
      let eventId = request.resource.data.lastStatusEventId;
      let eventPath = /databases/$(database)/documents/courses/$(courseId)/enrollments/$(studentUid)/status_events/$(eventId);
      let eventAfter = getAfter(eventPath).data;
      let coursePath = /databases/$(database)/documents/courses/$(courseId);
      let course = get(coursePath).data;
      let next = request.resource.data;
      return ownsExistingCourse(courseId)
        && exists(coursePath)
        && validEnrollmentShape(next)
        && resource.data.studentUid == studentUid
        && resource.data.ownerUid == request.auth.uid
        && resource.data.status in ['active', 'withdrawn']
        && next.studentUid == resource.data.studentUid
        && next.ownerUid == resource.data.ownerUid
        && next.name == resource.data.name
        && next.email == resource.data.email
        && next.studentCode == resource.data.studentCode
        && next.subject == resource.data.subject
        && next.group == resource.data.group
        && next.period == resource.data.period
        && next.createdAt == resource.data.createdAt
        && next.status in ['active', 'withdrawn']
        && next.status != resource.data.status
        && next.lastStatusEventId is string
        && next.lastStatusChangedAt == request.time
        && next.diff(resource.data).affectedKeys().hasOnly([
          'status', 'lastStatusEventId', 'lastStatusChangedAt'
        ])
        && !exists(eventPath)
        && existsAfter(eventPath)
        && validEnrollmentStatusEvent(eventAfter)
        && eventAfter.fromStatus == resource.data.status
        && eventAfter.toStatus == next.status
        && eventAfter.keys().hasAll(['effectiveDate'])
        && validEnrollmentStatusDate(
          courseId,
          studentUid,
          eventAfter.effectiveDate,
          next.status,
          resource.data,
          course
        )
        && eventAfter.changedAt == request.time
        && eventAfter.changedBy == request.auth.uid;
    }

    function canCreateEnrollmentStatusEvent(courseId, studentUid, eventId) {
      let enrollmentPathValue = enrollmentPath(courseId, studentUid);
      let enrollmentBefore = get(enrollmentPathValue).data;
      let enrollmentAfter = getAfter(enrollmentPathValue).data;
      let coursePath = /databases/$(database)/documents/courses/$(courseId);
      let course = get(coursePath).data;
      let event = request.resource.data;
      return ownsExistingCourse(courseId)
        && exists(coursePath)
        && validEnrollmentStatusEvent(event)
        && event.keys().hasAll(['effectiveDate'])
        && event.changedBy == request.auth.uid
        && event.changedAt == request.time
        && validEnrollmentStatusDate(
          courseId,
          studentUid,
          event.effectiveDate,
          event.toStatus,
          enrollmentBefore,
          course
        )
        && event.fromStatus == enrollmentBefore.status
        && event.toStatus == enrollmentAfter.status
        && event.fromStatus in ['active', 'withdrawn']
        && event.toStatus in ['active', 'withdrawn']
        && event.fromStatus != event.toStatus
        && enrollmentBefore.studentUid == studentUid
        && enrollmentBefore.ownerUid == request.auth.uid
        && enrollmentAfter.studentUid == enrollmentBefore.studentUid
        && enrollmentAfter.ownerUid == enrollmentBefore.ownerUid
        && enrollmentAfter.name == enrollmentBefore.name
        && enrollmentAfter.email == enrollmentBefore.email
        && enrollmentAfter.studentCode == enrollmentBefore.studentCode
        && enrollmentAfter.subject == enrollmentBefore.subject
        && enrollmentAfter.group == enrollmentBefore.group
        && enrollmentAfter.period == enrollmentBefore.period
        && enrollmentAfter.createdAt == enrollmentBefore.createdAt
        && enrollmentAfter.status == event.toStatus
        && enrollmentAfter.lastStatusEventId == eventId
        && enrollmentAfter.lastStatusChangedAt == request.time
        && enrollmentAfter.diff(enrollmentBefore).affectedKeys().hasOnly([
          'status', 'lastStatusEventId', 'lastStatusChangedAt'
        ]);
    }

    function validInvitationCode(code) {
      return code is string
        && code.matches('^[23456789ABCDEFGHJKLMNPQRSTUVWXYZ]{16}$');
    }

    function currentInvitationPath(courseId) {
      return /databases/$(database)/documents/courses/$(courseId)/invitation/current;
    }

    function courseInvitePath(code) {
      return /databases/$(database)/documents/course_invites/$(code);
    }

    function joinRequestPath(courseId, studentUid) {
      return /databases/$(database)/documents/courses/$(courseId)/join_requests/$(studentUid);
    }

    function validCurrentInvitation(invitation) {
      return invitation.keys().size() in [4, 5]
        && invitation.keys().hasAll([
          'code', 'status', 'createdAt', 'updatedAt'
        ])
        && invitation.keys().hasOnly([
          'code', 'status', 'createdAt', 'updatedAt', 'validForSeconds'
        ])
        && validInvitationCode(invitation.code)
        && invitation.status in ['active', 'paused', 'inactive']
        && invitation.createdAt is timestamp
        && invitation.updatedAt is timestamp
        && (!('validForSeconds' in invitation)
          || (invitation.validForSeconds is int
            && invitation.validForSeconds >= 3600
            && invitation.validForSeconds <= 7776000));
    }

    // One lifetime source: total seconds from the immutable server-createdAt.
    // Old four-field documents retain their original fourteen-day contract.
    function invitationValiditySeconds(invitation) {
      return 'validForSeconds' in invitation
        ? invitation.validForSeconds : 1209600;
    }

    function invitationExpiresAt(invitation) {
      return invitation.createdAt
        + duration.value(invitationValiditySeconds(invitation), 's');
    }

    function validCourseInvite(invitation) {
      return invitation.keys().size() == 5
        && invitation.keys().hasAll([
          'courseId', 'subject', 'group', 'period', 'createdAt'
        ])
        && invitation.courseId is string
        && invitation.courseId.size() > 0
        && nonBlankCourseText(invitation.subject, 120)
        && nonBlankCourseText(invitation.group, 40)
        && nonBlankCourseText(invitation.period, 32)
        && invitation.createdAt is timestamp;
    }

    function currentCourseInvite(code, courseId) {
      let invitePath = courseInvitePath(code);
      let currentPath = currentInvitationPath(courseId);
      let invite = get(invitePath).data;
      let current = get(currentPath).data;
      return exists(invitePath)
        && exists(currentPath)
        && validCourseInvite(invite)
        && validCurrentInvitation(current)
        && invite.courseId == courseId
        && invite.createdAt == current.createdAt
        && current.code == code
        && current.status == 'active'
        && request.time < invitationExpiresAt(current);
    }

    function validJoinRequest(requestData) {
      return requestData.keys().size() == 13
        && requestData.keys().hasAll([
          'studentUid', 'name', 'email', 'studentCode', 'subject', 'group',
          'period', 'invitationCode', 'status', 'createdAt', 'decidedBy',
          'decidedAt', 'rejectionReason'
        ])
        && requestData.studentUid is string
        && requestData.name is string
        && requestData.name.size() >= 1
        && requestData.name.size() <= 100
        && requestData.email is string
        && requestData.email.size() >= 3
        && requestData.email.size() <= 254
        && validStudentCode(requestData.studentCode)
        && nonBlankCourseText(requestData.subject, 120)
        && nonBlankCourseText(requestData.group, 40)
        && nonBlankCourseText(requestData.period, 32)
        && validInvitationCode(requestData.invitationCode)
        && requestData.status in ['pending', 'approved', 'rejected']
        && requestData.createdAt is timestamp
        && (requestData.decidedBy == null || requestData.decidedBy is string)
        && (requestData.decidedAt == null || requestData.decidedAt is timestamp)
        && (
          requestData.rejectionReason == null
          || (
            requestData.rejectionReason is string
            && requestData.rejectionReason.size() >= 1
            && requestData.rejectionReason.size() <= 500
          )
        );
    }

    function currentCourseExistsAndOwned(courseId) {
      let coursePath = /databases/$(database)/documents/courses/$(courseId);
      return exists(coursePath)
        && get(coursePath).data.ownerUid == request.auth.uid;
    }

    function matchingInviteAfter(courseId, code, inviteData) {
      let coursePath = /databases/$(database)/documents/courses/$(courseId);
      let currentAfter = getAfter(currentInvitationPath(courseId)).data;
      let course = get(coursePath).data;
      return exists(coursePath)
        && validCourseInvite(inviteData)
        && validCurrentInvitation(currentAfter)
        && 'validForSeconds' in currentAfter
        && currentAfter.code == code
        && currentAfter.status == 'active'
        && currentAfter.createdAt == request.time
        && currentAfter.updatedAt == request.time
        && inviteData.courseId == courseId
        && inviteData.subject == course.subject
        && inviteData.group == course.group
        && inviteData.period == course.period
        && inviteData.createdAt == request.time;
    }

    function canCreateCurrentInvitation(courseId) {
      let code = request.resource.data.code;
      return verifiedTeacher()
        && validInvitationCode(code)
        // Detect collisions before evaluating the cross-document snapshots.
        && !exists(courseInvitePath(code))
        && currentCourseExistsAndOwned(courseId)
        && validCurrentInvitation(request.resource.data)
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && matchingInviteAfter(
          courseId,
          code,
          getAfter(courseInvitePath(code)).data
        );
    }

    function canUpdateCurrentInvitation(courseId) {
      let next = request.resource.data;
      return verifiedTeacher()
        && currentCourseExistsAndOwned(courseId)
        && validCurrentInvitation(resource.data)
        && validCurrentInvitation(next)
        && next.updatedAt == request.time
        && (
          (
            next.status == 'active'
            && next.code != resource.data.code
            && !exists(courseInvitePath(next.code))
            && next.createdAt == request.time
            && next.updatedAt == request.time
            && matchingInviteAfter(
              courseId,
              next.code,
              getAfter(courseInvitePath(next.code)).data
            )
          )
          || (
            canChangeSameInvitation(resource.data, next)
          )
        );
    }

    function canChangeSameInvitation(previous, next) {
      let sameValidity = invitationValiditySeconds(previous)
        == invitationValiditySeconds(next);
      let onlyStatus = next.diff(previous).affectedKeys()
        .hasOnly(['status', 'updatedAt']);
      return previous.status != 'inactive'
        && next.code == previous.code
        && next.createdAt == previous.createdAt
        && next.diff(previous).affectedKeys()
          .hasOnly(['status', 'updatedAt', 'validForSeconds'])
        && (
          (next.status == 'inactive' && sameValidity && onlyStatus)
          || (request.time < invitationExpiresAt(previous)
            && (
              (sameValidity && onlyStatus && (
                (previous.status == 'active' && next.status == 'paused')
                || (previous.status == 'paused' && next.status == 'active')
              ))
              || (next.status == previous.status
                && 'validForSeconds' in next
                && request.time < invitationExpiresAt(next))
            ))
        );
    }

    function canReadCurrentCourseInvite(code, courseId) {
      return verifiedStudent()
        && validInvitationCode(code)
        && currentCourseInvite(code, courseId);
    }

    function canCreateCourseInvite(code) {
      let invite = request.resource.data;
      return verifiedTeacher()
        && validInvitationCode(code)
        && validCourseInvite(invite)
        && currentCourseExistsAndOwned(invite.courseId)
        && matchingInviteAfter(invite.courseId, code, invite);
    }

    function canCreateJoinRequest(courseId, studentUid) {
      let requestData = request.resource.data;
      let profilePath = /databases/$(database)/documents/users/$(studentUid);
      let profile = get(profilePath).data;
      let invitePath = courseInvitePath(requestData.invitationCode);
      let invite = get(invitePath).data;
      let currentPath = currentInvitationPath(courseId);
      let current = get(currentPath).data;
      let enrollment = enrollmentPath(courseId, studentUid);
      return emailVerified()
        && request.auth.uid == studentUid
        && validJoinRequest(requestData)
        && requestData.status == 'pending'
        && requestData.createdAt == request.time
        && requestData.decidedBy == null
        && requestData.decidedAt == null
        && requestData.rejectionReason == null
        && !existsAfter(enrollment)
        && exists(profilePath)
        && validProfileShape(profile)
        && profile.email == request.auth.token.email
        && profile.roles.hasAny(['student'])
        && profile.email == requestData.email
        && profile.name == requestData.name
        && profile.studentCode == requestData.studentCode
        && exists(invitePath)
        && exists(currentPath)
        && invite.courseId == courseId
        && invite.createdAt == current.createdAt
        && current.code == requestData.invitationCode
        && current.status == 'active'
        && request.time < invitationExpiresAt(current)
        && requestData.subject == invite.subject
        && requestData.group == invite.group
        && requestData.period == invite.period;
    }

    function canCreateEnrollmentFromJoinRequest(
      courseId,
      studentUid,
      course,
      enrollment,
      requestBefore
    ) {
      let requestPath = joinRequestPath(courseId, studentUid);
      let requestAfter = getAfter(requestPath).data;
      return requestBefore.studentUid == studentUid
        && requestBefore.status == 'pending'
        && requestAfter.status == 'approved'
        && requestAfter.decidedBy == request.auth.uid
        && requestAfter.decidedAt == request.time
        && enrollment.studentUid == studentUid
        && enrollment.ownerUid == request.auth.uid
        && enrollment.email == requestBefore.email
        && enrollment.studentCode == requestBefore.studentCode
        && requestBefore.subject == course.subject
        && requestBefore.group == course.group
        && requestBefore.period == course.period
        && enrollment.subject == course.subject
        && enrollment.group == course.group
        && enrollment.period == course.period
        && enrollment.status == 'active'
        && enrollment.createdAt == request.time
        && enrollment.rosterEntryId == enrollment.email
        && validEffectiveDateForCourse(
          enrollment.effectiveStartDate,
          course,
          true
        );
    }

    function canCreateEnrollmentFromDirectory(studentUid, enrollment) {
      let entryPath = directoryPath(enrollment.email);
      let entry = get(entryPath).data;
      return exists(entryPath)
        && directoryMatchesCurrentProfile(entry)
        && entry.uid == studentUid
        && entry.name == enrollment.name
        && entry.email == enrollment.email
        && entry.studentCode == enrollment.studentCode;
    }

    function canCreateEnrollmentFromAvailableSource(
      courseId,
      studentUid,
      course,
      enrollment
    ) {
      let requestPath = joinRequestPath(courseId, studentUid);
      return exists(requestPath)
        ? canCreateEnrollmentFromRequestOrDirectory(
            courseId,
            studentUid,
            course,
            enrollment
          )
        : canCreateEnrollmentFromDirectory(studentUid, enrollment);
    }

    function canCreateEnrollmentFromRequestOrDirectory(
      courseId,
      studentUid,
      course,
      enrollment
    ) {
      let requestPath = joinRequestPath(courseId, studentUid);
      let requestBefore = get(requestPath).data;
      return requestBefore.status == 'pending'
        ? canCreateEnrollmentFromJoinRequest(
            courseId,
            studentUid,
            course,
            enrollment,
            requestBefore
          )
        : canCreateEnrollmentFromDirectory(studentUid, enrollment);
    }

    function enrollmentSnapshotMatchesRequestCourse(course, studentUid, enrollment) {
      return enrollment.studentUid == studentUid
        && enrollment.status == 'active'
        && enrollment.ownerUid == course.ownerUid
        && enrollment.email == request.resource.data.email
        && enrollment.studentCode == request.resource.data.studentCode
        && enrollment.subject == course.subject
        && enrollment.group == course.group
        && enrollment.period == course.period;
    }

    function teacherCanApproveMatchingPendingJoinRequest(
      courseId,
      studentUid,
      course,
      requestBefore,
      requestAfter
    ) {
      let pendingPath = pendingEnrollmentPath(courseId, requestBefore.email);
      let pendingBefore = get(pendingPath).data;
      let pendingAfter = getAfter(pendingPath).data;
      return exists(pendingPath)
        && pendingBefore.courseId == courseId
        && pendingBefore.ownerUid == course.ownerUid
        && request.auth.uid == pendingBefore.ownerUid
        && pendingBefore.status == 'pending'
        && pendingBefore.studentUid == null
        && pendingBefore.email == requestBefore.email
        && pendingBefore.studentCode == requestBefore.studentCode
        && pendingBefore.subject == requestBefore.subject
        && pendingBefore.group == requestBefore.group
        && pendingBefore.period == requestBefore.period
        && pendingAfter.status == 'linked'
        && pendingAfter.studentUid == studentUid
        && requestAfter.status == 'approved'
        && requestAfter.rejectionReason == null
        && requestAfter.decidedBy == request.auth.uid
        && requestAfter.decidedAt == request.time
        && existsAfter(enrollmentPath(courseId, studentUid));
    }

    function studentCanResolveMatchingAuthorizedJoinRequest(
      courseId,
      studentUid,
      course,
      requestBefore,
      requestAfter
    ) {
      let pendingPath = pendingEnrollmentPath(courseId, requestBefore.email);
      let pendingBefore = get(pendingPath).data;
      let pendingAfter = getAfter(pendingPath).data;
      return exists(pendingPath)
        && request.auth.uid == studentUid
        && requestBefore.status == 'pending'
        && requestAfter.status == 'approved'
        && requestAfter.decidedBy == pendingBefore.ownerUid
        && requestAfter.decidedAt == request.time
        && requestAfter.rejectionReason == null
        && pendingBefore.ownerUid == course.ownerUid
        && pendingBefore.status == 'pending'
        && pendingBefore.studentUid == null
        && pendingBefore.email == requestBefore.email
        && pendingBefore.studentCode == requestBefore.studentCode
        && pendingBefore.subject == requestBefore.subject
        && pendingBefore.group == requestBefore.group
        && pendingBefore.period == requestBefore.period
        && pendingAfter.status == 'linked'
        && pendingAfter.studentUid == studentUid
        // The pending update and canonical enrollment writes in this same
        // transaction have their own reciprocal rules; this branch binds the
        // immutable join-request snapshot to the owner's authorization.
        && existsAfter(enrollmentPath(courseId, studentUid));
    }

    function canDecideJoinRequest(courseId, studentUid) {
      let enrollmentPathValue = enrollmentPath(courseId, studentUid);
      let coursePath = /databases/$(database)/documents/courses/$(courseId);
      let course = get(coursePath).data;
      let before = resource.data;
      let next = request.resource.data;
      let identityUnchanged = next.diff(before).affectedKeys()
          .hasOnly(['status', 'decidedBy', 'decidedAt', 'rejectionReason'])
        && before.studentUid == studentUid
        && before.status == 'pending';
      return exists(coursePath)
        && identityUnchanged
        && (
          (
            next.status == 'approved'
            && next.rejectionReason == null
            && teacherCanApproveMatchingPendingJoinRequest(
              courseId,
              studentUid,
              course,
              before,
              next
            )
          )
          || (
            verifiedTeacher()
              ? (
              course.ownerUid == request.auth.uid
              && next.decidedBy == request.auth.uid
              && next.decidedAt == request.time
              && (
                (
                  next.status == 'approved'
                  && next.rejectionReason == null
                  && existsAfter(enrollmentPathValue)
                  && enrollmentSnapshotMatchesRequestCourse(
                    course,
                    studentUid,
                    getAfter(enrollmentPathValue).data
                  )
                )
                || (
                  next.status == 'rejected'
                  && next.rejectionReason is string
                  && next.rejectionReason.size() >= 1
                  && next.rejectionReason.size() <= 500
                  && !existsAfter(enrollmentPathValue)
                )
              )
              )
              : (
                next.status == 'approved'
                && studentCanResolveMatchingAuthorizedJoinRequest(
                  courseId,
                  studentUid,
                  course,
                  before,
                  next
                )
              )
          )
        );
    }

    function canCreateEnrollment(courseId, studentUid) {
      let enrollment = request.resource.data;
      // Use conditional branches for cheap gates. Invalid identities and maps
      // should stop before profile, course, directory, and request lookups.
      return enrollment.studentUid == studentUid
        && (
          enrollment.ownerUid == request.auth.uid
            ? verifiedTeacher()
              && enrollment.status == 'active'
              && !('lastStatusEventId' in enrollment)
              && !('lastStatusChangedAt' in enrollment)
              && 'rosterEntryId' in enrollment
              && 'effectiveStartDate' in enrollment
              && enrollment.createdAt == request.time
              && canCreateEnrollmentForOwnedCourse(
                courseId,
                studentUid,
                enrollment
              )
            : canCreateEnrollmentFromOwnPending(courseId, studentUid)
        );
    }

    function canCreateEnrollmentForOwnedCourse(courseId, studentUid, enrollment) {
      let coursePath = /databases/$(database)/documents/courses/$(courseId);
      let course = get(coursePath).data;
      let pendingPath = pendingEnrollmentPath(courseId, enrollment.email);
      return exists(coursePath)
        && course.ownerUid == request.auth.uid
        && (
          exists(pendingPath)
            ? (
                validEnrollmentFromPendingShape(enrollment)
                  && pendingEnrollmentLinkMatches(courseId, enrollment)
              )
            : (
                validEnrollmentShape(enrollment)
                  && enrollment.ownerUid == course.ownerUid
                  && enrollment.subject == course.subject
                  && enrollment.group == course.group
                  && enrollment.period == course.period
                  && enrollment.rosterEntryId == enrollment.email
                  && validEffectiveDateForCourse(
                    enrollment.effectiveStartDate,
                    course,
                    true
                  )
                  && canCreateEnrollmentFromAvailableSource(
                    courseId,
                    studentUid,
                    course,
                    enrollment
                  )
              )
        );
    }

    function ownsExistingCourse(courseId) {
      let coursePath = /databases/$(database)/documents/courses/$(courseId);
      return verifiedTeacher()
        && exists(coursePath)
        && get(coursePath).data.ownerUid == request.auth.uid;
    }

    function studentEnrolledInCourse(courseId) {
      let enrollment = enrollmentPath(courseId, request.auth.uid);
      return verifiedStudent()
        && exists(enrollment)
        && get(enrollment).data.studentUid == request.auth.uid
        && get(enrollment).data.status == 'active';
    }

    function nonBlankCourseText(value, maxLength) {
      return value is string
        && value.matches('.*[^\\s].*')
        && value.size() <= maxLength;
    }

    function courseBlockPath(courseId, blockId) {
      return /databases/$(database)/documents/courses/$(courseId)/weekly_blocks/$(blockId);
    }

    function validCourseBlockIdAt(blockIds, count, index) {
      return count <= index
        || (
          blockIds[index] is string
          && blockIds[index].matches('^[A-Za-z0-9_-]{20,40}$')
        );
    }

    function validCourseBlockIds(blockIds) {
      let count = blockIds.size();
      return blockIds is list
        && count >= 1
        && count <= 8
        && blockIds.toSet().size() == count
        && validCourseBlockIdAt(blockIds, count, 0)
        && validCourseBlockIdAt(blockIds, count, 1)
        && validCourseBlockIdAt(blockIds, count, 2)
        && validCourseBlockIdAt(blockIds, count, 3)
        && validCourseBlockIdAt(blockIds, count, 4)
        && validCourseBlockIdAt(blockIds, count, 5)
        && validCourseBlockIdAt(blockIds, count, 6)
        && validCourseBlockIdAt(blockIds, count, 7);
    }

    // Every listed child must be visible after this atomic create and have the
    // same order as its position in weeklyBlockIds.
    function validCourseBlockAfterAt(courseId, blockIds, count, index) {
      return count <= index
        || (
          getAfter(courseBlockPath(courseId, blockIds[index])).data.order
            == index
        );
    }

    function allCourseBlocksAfter(courseId, blockIds) {
      let count = blockIds.size();
      return validCourseBlockAfterAt(courseId, blockIds, count, 0)
        && validCourseBlockAfterAt(courseId, blockIds, count, 1)
        && validCourseBlockAfterAt(courseId, blockIds, count, 2)
        && validCourseBlockAfterAt(courseId, blockIds, count, 3)
        && validCourseBlockAfterAt(courseId, blockIds, count, 4)
        && validCourseBlockAfterAt(courseId, blockIds, count, 5)
        && validCourseBlockAfterAt(courseId, blockIds, count, 6)
        && validCourseBlockAfterAt(courseId, blockIds, count, 7);
    }

    function validCourseDateRange(startDate, endDate) {
      return startDate is timestamp
        && endDate is timestamp
        && startDate <= endDate
        && startDate.date() == startDate
        && endDate.date() == endDate
        && endDate.toMillis() - startDate.toMillis() <= 365 * 86400000;
    }

    function validCourseShape(courseId, course) {
      return course.keys().size() == 13
        && course.ownerUid is string
        && nonBlankCourseText(course.subject, 120)
        && nonBlankCourseText(course.group, 40)
        && nonBlankCourseText(course.period, 32)
        && nonBlankCourseText(course.program, 120)
        && course.timezone == 'America/Bogota'
        && validCourseDateRange(course.startDate, course.endDate)
        && validCourseBlockIds(course.weeklyBlockIds)
        && allCourseBlocksAfter(courseId, course.weeklyBlockIds)
        && course.status == 'planned'
        && course.schemaVersion is int
        && course.schemaVersion == 1
        && course.createdAt is timestamp
        && course.updatedAt is timestamp;
    }

    function validCourseBlockShape(block) {
      return block.keys().size() == 5
        && block.weekday is int
        && block.weekday >= 1
        && block.weekday <= 7
        && block.startMinute is int
        && block.startMinute >= 0
        && block.startMinute < 1440
        && block.endMinute is int
        && block.endMinute > block.startMinute
        && block.endMinute < 1440
        && block.order is int
        && block.order >= 0
        && block.order < 8
        && (
          block.room == null
          || (block.room is string && block.room.size() <= 60)
        );
    }

    function courseBlockOccursInDateRange(course, weekday) {
      let startDate = course.startDate;
      let endDate = course.endDate;
      let daysUntilWeekday = (weekday - startDate.dayOfWeek() + 7) % 7;
      return endDate.toMillis() - startDate.toMillis() >= 6 * 86400000
        || startDate.toMillis() + daysUntilWeekday * 86400000
          <= endDate.toMillis();
    }

    function orderedCourseBlockPair(previous, current) {
      return previous.order + 1 == current.order
        && previous.weekday <= current.weekday
        && (
          previous.weekday != current.weekday
          || previous.endMinute <= current.startMinute
        );
    }

    function previousCourseBlockIsValid(courseId, blockIds, current) {
      let order = current.order;
      return order == 0
        || (
          orderedCourseBlockPair(
            getAfter(courseBlockPath(courseId, blockIds[order - 1])).data,
            current
          )
        );
    }

    function nextCourseBlockIsValid(courseId, blockIds, current) {
      let order = current.order;
      let count = blockIds.size();
      return order == count - 1
        || (
          orderedCourseBlockPair(
            current,
            getAfter(courseBlockPath(courseId, blockIds[order + 1])).data
          )
        );
    }

    function validCourseBlockCreate(courseId, blockId, block) {
      let course = getAfter(
        /databases/$(database)/documents/courses/$(courseId)
      ).data;
      let blockIds = course.weeklyBlockIds;
      let order = block.order;
      let count = blockIds.size();
      // The parent create is the trust boundary: it requires a verified
      // teacher with a valid profile and atomically validates every listed
      // child. Rechecking the full profile for each child would multiply the
      // expression cost across a maximum-size atomic write.
      return course.ownerUid == request.auth.uid
        && blockIds is list
        && count >= 1
        && count <= 8
        && validCourseBlockShape(block)
        && order >= 0
        && order < count
        && blockIds[order] == blockId
        && courseBlockOccursInDateRange(course, block.weekday)
        && previousCourseBlockIsValid(courseId, blockIds, block)
        && nextCourseBlockIsValid(courseId, blockIds, block);
    }

    function canReadCourseBlock(courseId, blockId) {
      let parentPath = /databases/$(database)/documents/courses/$(courseId);
      let childPath = courseBlockPath(courseId, blockId);
      let course = get(parentPath).data;
      return (verifiedTeacher() || studentEnrolledInCourse(courseId))
        && (
          (!exists(parentPath) && !exists(childPath))
          || (
            exists(parentPath)
            && exists(childPath)
            && (course.ownerUid == request.auth.uid
              || studentEnrolledInCourse(courseId))
            && course.weeklyBlockIds is list
            && course.weeklyBlockIds.hasAny([blockId])
          )
        );
    }

    function canListCourseBlocks(courseId) {
      let parentPath = /databases/$(database)/documents/courses/$(courseId);
      let course = get(parentPath).data;
      return (verifiedTeacher() || studentEnrolledInCourse(courseId))
        && exists(parentPath)
        && (course.ownerUid == request.auth.uid
          || studentEnrolledInCourse(courseId));
    }

    function canGetCourse(courseId) {
      let coursePath = /databases/$(database)/documents/courses/$(courseId);
      // The transaction may read a missing ID to create it. Existing records
      // remain private to their owner even when another teacher knows the ID.
      return (verifiedTeacher()
          && (!exists(coursePath) || resource.data.ownerUid == request.auth.uid))
        || (exists(coursePath) && studentEnrolledInCourse(courseId));
    }

    function attendanceConfigPath(courseId) {
      return /databases/$(database)/documents/courses/$(courseId)/attendance_config/current;
    }

    function attendanceSessionPath(courseId, occurrenceId) {
      return /databases/$(database)/documents/courses/$(courseId)/attendance_sessions/$(occurrenceId);
    }

    function attendanceRosterPath(courseId, occurrenceId, rosterEntryId) {
      return /databases/$(database)/documents/courses/$(courseId)/attendance_sessions/$(occurrenceId)/roster/$(rosterEntryId);
    }

    function attendanceEventPath(courseId, occurrenceId, eventId) {
      return /databases/$(database)/documents/courses/$(courseId)/attendance_sessions/$(occurrenceId)/events/$(eventId);
    }

    function attendanceRecordPath(courseId, recordId) {
      return /databases/$(database)/documents/courses/$(courseId)/attendance_records/$(recordId);
    }

    function validAcademicTimestamp(value) {
      return value is timestamp && value.date() == value;
    }

    function validAttendanceConfig(config) {
      return config.keys().hasAll([
          'schemaVersion', 'mode', 'sessionCount', 'createdAt', 'createdBy',
          'updatedAt', 'updatedBy', 'lastSessionId'
        ])
        && config.keys().hasOnly([
          'schemaVersion', 'mode', 'sessionCount', 'createdAt', 'createdBy',
          'updatedAt', 'updatedBy', 'lastSessionId'
        ])
        && config.schemaVersion == 1
        && config.mode in ['meeting', 'minutes']
        && config.sessionCount is int
        && config.sessionCount >= 0
        && config.createdAt is timestamp
        && config.createdBy is string
        && config.updatedAt is timestamp
        && config.updatedBy is string
        && (config.lastSessionId == null || config.lastSessionId is string);
    }

    function canGetAttendanceConfig(courseId) {
      let coursePath = /databases/$(database)/documents/courses/$(courseId);
      return verifiedTeacher()
        && (!exists(coursePath)
          || get(coursePath).data.ownerUid == request.auth.uid);
    }

    function canCreateAttendanceConfig(courseId, configId) {
      let coursePath = /databases/$(database)/documents/courses/$(courseId);
      let courseAfter = getAfter(coursePath).data;
      let config = request.resource.data;
      return configId == 'current'
        && verifiedTeacher()
        && existsAfter(coursePath)
        && courseAfter.ownerUid == request.auth.uid
        && validAttendanceConfig(config)
        && config.sessionCount == 0
        && config.createdAt == request.time
        && config.createdBy == request.auth.uid
        && config.updatedAt == request.time
        && config.updatedBy == request.auth.uid
        && config.lastSessionId == null;
    }

    function canChangeAttendanceConfig(courseId, configId) {
      let before = resource.data;
      let after = request.resource.data;
      return configId == 'current'
        && ownsExistingCourse(courseId)
        && validAttendanceConfig(after)
        && before.sessionCount == 0
        && after.sessionCount == 0
        && after.lastSessionId == before.lastSessionId
        && after.schemaVersion == before.schemaVersion
        && after.sessionCount == before.sessionCount
        && after.createdAt == before.createdAt
        && after.createdBy == before.createdBy
        && after.updatedAt == request.time
        && after.updatedBy == request.auth.uid
        && after.diff(before).affectedKeys().hasOnly([
          'mode', 'updatedAt', 'updatedBy'
        ]);
    }

    function canIncrementAttendanceSessionCount(courseId, configId) {
      let before = resource.data;
      let after = request.resource.data;
      let sessionPath = attendanceSessionPath(courseId, after.lastSessionId);
      let session = getAfter(sessionPath).data;
      return configId == 'current'
        && after.lastSessionId is string
        && after.lastSessionId.size() > 0
        && after.lastSessionId.size() <= 128
        && after.sessionCount == before.sessionCount + 1
        && existsAfter(sessionPath)
        && !exists(sessionPath)
        && ownsExistingCourse(courseId)
        && validAttendanceConfig(after)
        && after.mode == before.mode
        && after.createdAt == before.createdAt
        && after.createdBy == before.createdBy
        && after.updatedAt == request.time
        && after.updatedBy == request.auth.uid
        // The paired create rule validates the complete session shape. Keep
        // this reciprocal half deliberately small to avoid evaluating that
        // large shape a second time in the same transaction.
        && session.courseId == courseId
        && session.occurrenceId == after.lastSessionId
        && session.ownerUid == request.auth.uid
        && session.mode == after.mode
        && session.status == 'preparing'
        && session.rosterState == 'building'
        && session.version == 1
        && after.diff(before).affectedKeys().hasOnly([
          'sessionCount', 'lastSessionId', 'updatedAt', 'updatedBy'
        ]);
    }

    function validAttendanceCalendarChange(occurrenceId, change) {
      return change.keys().hasAll([
          'occurrenceId', 'kind', 'originalDate', 'effectiveDate',
          'startMinute', 'endMinute', 'reason', 'version', 'createdAt',
          'createdBy', 'updatedAt', 'updatedBy'
        ])
        && change.keys().hasOnly([
          'occurrenceId', 'kind', 'originalDate', 'effectiveDate',
          'startMinute', 'endMinute', 'reason', 'version', 'createdAt',
          'createdBy', 'updatedAt', 'updatedBy'
        ])
        && change.occurrenceId == occurrenceId
        && change.kind in ['cancelled', 'rescheduled', 'additional']
        && validAcademicTimestamp(change.originalDate)
        && validAcademicTimestamp(change.effectiveDate)
        && change.startMinute is int
        && change.startMinute >= 0
        && change.startMinute < 1440
        && change.endMinute is int
        && change.endMinute > change.startMinute
        && change.endMinute <= 1440
        && change.reason is string
        && change.reason.size() <= 500
        && change.version is int
        && change.version >= 1
        && change.createdAt is timestamp
        && change.createdBy is string
        && change.updatedAt is timestamp
        && change.updatedBy is string;
    }

    function validNewAttendanceSession(courseId, occurrenceId, session) {
      // A new session can only enter the building state. Keeping this
      // predicate focused avoids re-evaluating finalization/void metadata
      // during the paired config-counter write.
      return session.keys().hasOnly([
          'schemaVersion', 'courseId', 'ownerUid', 'occurrenceId',
          'occurrenceKind', 'mode', 'status', 'rosterState', 'scheduledDate',
          'effectiveDate', 'startMinute', 'endMinute', 'timezone', 'segmentIds',
          'rosterCount', 'markedCount', 'unmarkedCount', 'unmarkedConfirmed',
          'version', 'lastMutationRosterEntryId', 'lastMutationKind',
          'lastEventId', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy',
          'lateRegistrationReason'
        ])
        && session.schemaVersion == 1
        && session.courseId == courseId
        && session.ownerUid == request.auth.uid
        && session.occurrenceId == occurrenceId
        && session.occurrenceKind in ['planned', 'cancelled', 'rescheduled', 'additional']
        && session.mode in ['meeting', 'minutes']
        && session.status == 'preparing'
        && session.rosterState == 'building'
        && validAcademicTimestamp(session.scheduledDate)
        && validAcademicTimestamp(session.effectiveDate)
        && session.startMinute is int
        && session.startMinute >= 0
        && session.startMinute < 1440
        && session.endMinute is int
        && session.endMinute > session.startMinute
        && session.endMinute <= 1440
        && session.timezone == 'America/Bogota'
        && session.segmentIds is list
        && session.segmentIds.size() <= 24
        && session.segmentIds.toSet().size() == session.segmentIds.size()
        && session.rosterCount is int
        && session.rosterCount >= 0
        && session.markedCount == 0
        && session.unmarkedCount == session.rosterCount
        && session.unmarkedConfirmed == false
        && session.version == 1
        && session.lastMutationRosterEntryId == null
        && session.lastMutationKind == null
        && session.lastEventId == null
        && session.createdAt == request.time
        && session.createdBy == request.auth.uid
        && session.updatedAt == request.time
        && session.updatedBy == request.auth.uid
        && (session.get('lateRegistrationReason', null) == null
          || (session.get('lateRegistrationReason', null) is string
            && session.get('lateRegistrationReason', null).size() >= 0
            && session.get('lateRegistrationReason', null).size() <= 500))
        && (session.mode == 'meeting'
          ? session.segmentIds.size() == 0
          : session.segmentIds.size() >= 1);
    }

    function studentAttendanceRosterId(courseId) {
      let enrollment = get(enrollmentPath(courseId, request.auth.uid)).data;
      return enrollment.keys().hasAny(['rosterEntryId'])
        && enrollment.rosterEntryId is string
        ? enrollment.rosterEntryId
        : 'legacy:' + request.auth.uid;
    }

    function studentAttendanceSessionAllowsRecord(courseId, record) {
      let path = attendanceSessionPath(courseId, record.sessionId);
      let session = get(path).data;
      return exists(path)
        && session.courseId == courseId
        && session.occurrenceId == record.sessionId
        && ((session.status == 'finalized' && record.result != 'voided')
          || (session.status == 'voided' && record.result == 'voided'));
    }

    function studentCanReadAttendanceRecord(courseId, recordId) {
      let enrollmentDocPath = enrollmentPath(courseId, request.auth.uid);
      let record = resource.data;
      return verifiedStudent()
        && exists(enrollmentDocPath)
        && get(enrollmentDocPath).data.studentUid == request.auth.uid
        && get(enrollmentDocPath).data.status == 'active'
        && record.sessionId is string
        && record.visibility == 'published'
        && record.rosterEntryId == studentAttendanceRosterId(courseId)
        && validAttendanceRecord(courseId, recordId, record)
        && studentAttendanceSessionAllowsRecord(courseId, record);
    }

    function studentCanListAttendanceRecords(courseId) {
      let enrollmentDocPath = enrollmentPath(courseId, request.auth.uid);
      let enrollment = get(enrollmentDocPath).data;
      return verifiedStudent()
        && exists(enrollmentDocPath)
        && enrollment.studentUid == request.auth.uid
        && enrollment.status == 'active'
        && resource.data.visibility == 'published'
        && resource.data.rosterEntryId == studentAttendanceRosterId(courseId);
    }

    function validAttendanceRecord(courseId, recordId, record) {
      let start = record.startMinute;
      let end = record.endMinute;
      let units = record.unitCount;
      let absent = record.absentUnits;
      let inReview = record.inReviewUnits;
      let justified = record.justifiedUnits;
      // Every required field is accessed below (a missing key denies access).
      // Keep the exact allowlist without evaluating the same key list twice.
      return record.keys().hasOnly([
          'schemaVersion', 'courseId', 'sessionId', 'rosterEntryId',
          'visibility', 'mode', 'scheduledDate', 'effectiveDate',
          'startMinute', 'endMinute', 'unitCount', 'absentUnits',
          'inReviewUnits', 'justifiedUnits', 'result', 'segments',
          'publishedAt', 'updatedAt'
        ])
        && record.schemaVersion == 1
        && record.courseId == courseId
        && record.sessionId is string
        && record.rosterEntryId is string
        && recordId == record.sessionId + '|' + record.rosterEntryId
        && record.visibility in ['staged', 'published']
        && record.mode in ['meeting', 'minutes']
        && validAcademicTimestamp(record.scheduledDate)
        && validAcademicTimestamp(record.effectiveDate)
        && start is int && start >= 0 && start < 1440
        && end is int && end > start && end <= 1440
        && units is int && units >= 0
        && absent is int && absent >= 0
        && inReview is int && inReview >= 0
        && justified is int && justified >= 0
        && absent <= units
        && inReview <= absent
        && justified <= absent
        && record.result in ['unmarked', 'present', 'absent', 'partial', 'justified', 'voided']
        && (record.result == 'voided'
          ? (units == 0 && absent == 0 && inReview == 0 && justified == 0)
          : units > 0)
        && (record.visibility == 'staged'
          ? record.publishedAt == null
          : (record.publishedAt is timestamp && record.result != 'unmarked'))
        && record.updatedAt is timestamp
        && (record.mode == 'meeting'
          ? ((units == 1 || record.result == 'voided')
            && !record.keys().hasAny(['segments']))
          : (record.result == 'voided'
            ? !record.keys().hasAny(['segments'])
            : validAttendanceRecordSegments(record.segments)));
    }

    // Corrections and justifications revalidate the result and its segments.
    function validAttendanceRecordResult(record) {
      let units = record.unitCount;
      let absent = record.absentUnits;
      let inReview = record.inReviewUnits;
      let justified = record.justifiedUnits;
      return units is int && units >= 0
        && absent is int && absent >= 0
        && inReview is int && inReview >= 0
        && justified is int && justified >= 0
        && absent <= units
        && inReview <= absent
        && justified <= absent
        && record.result in ['unmarked', 'present', 'absent', 'partial', 'justified', 'voided']
        && (record.result == 'voided'
          ? (units == 0 && absent == 0 && inReview == 0 && justified == 0)
          : units > 0)
        && (record.visibility == 'staged'
          ? record.publishedAt == null
          : (record.publishedAt is timestamp && record.result != 'unmarked'))
        && record.updatedAt is timestamp
        && (record.mode == 'meeting'
          ? ((units == 1 || record.result == 'voided')
            && !record.keys().hasAny(['segments']))
          : (record.result == 'voided'
            ? !record.keys().hasAny(['segments'])
            : validAttendanceRecordSegments(record.segments)));
    }

    function attendanceStartHasPassed(session) {
      let bogotaNow = request.time - duration.value(5, 'h');
      return session.effectiveDate < bogotaNow.date()
        || (session.effectiveDate == bogotaNow.date()
          && bogotaNow.hours() * 60 + bogotaNow.minutes() >= session.startMinute);
    }

    function validAttendanceRosterMark(mark) {
      return mark is map
        && mark.keys().hasAll([
          'mark', 'absentUnits', 'justificationStatus', 'justifiedUnits'
        ])
        && mark.keys().hasOnly([
          'mark', 'absentUnits', 'justificationStatus', 'justifiedUnits'
        ])
        && mark.mark in ['unmarked', 'present', 'absent']
        && mark.absentUnits is int
        && mark.absentUnits >= 0
        && mark.justificationStatus in ['none', 'inReview', 'justified', 'notAccepted']
        && mark.justifiedUnits is int
        && mark.justifiedUnits >= 0
        && mark.justifiedUnits <= mark.absentUnits
        && (mark.mark == 'absent' || mark.absentUnits == 0)
        && (mark.justificationStatus != 'none' || mark.justifiedUnits == 0);
    }

    function validAttendanceSegmentMarkAt(
      marks,
      segmentIds,
      count,
      index,
      requireUnmarked
    ) {
      return count <= index
        ? true
        : (requireUnmarked
          ? (validAttendanceRosterMark(marks[segmentIds[index]])
            && marks[segmentIds[index]].mark == 'unmarked'
            && marks[segmentIds[index]].absentUnits == 0
            && marks[segmentIds[index]].justificationStatus == 'none'
            && marks[segmentIds[index]].justifiedUnits == 0)
          : validAttendanceRosterMark(marks[segmentIds[index]]));
    }

    function validAttendanceSegmentMarks(marks, segmentIds, requireUnmarked) {
      let count = segmentIds.size();
      // Short-circuit the tail at the actual segment count. A flat chain still
      // evaluates 24 guards repeatedly and exceeds the limit on two-hour retries.
      return marks is map
        && marks.keys().hasAll(segmentIds)
        && marks.keys().hasOnly(segmentIds)
        && (count <= 0 || validAttendanceSegmentMarkAt(marks, segmentIds, count, 0, requireUnmarked)
          && (count <= 1 || validAttendanceSegmentMarkAt(marks, segmentIds, count, 1, requireUnmarked)
          && (count <= 2 || validAttendanceSegmentMarkAt(marks, segmentIds, count, 2, requireUnmarked)
          && (count <= 3 || validAttendanceSegmentMarkAt(marks, segmentIds, count, 3, requireUnmarked)
          && (count <= 4 || validAttendanceSegmentMarkAt(marks, segmentIds, count, 4, requireUnmarked)
          && (count <= 5 || validAttendanceSegmentMarkAt(marks, segmentIds, count, 5, requireUnmarked)
          && (count <= 6 || validAttendanceSegmentMarkAt(marks, segmentIds, count, 6, requireUnmarked)
          && (count <= 7 || validAttendanceSegmentMarkAt(marks, segmentIds, count, 7, requireUnmarked)
