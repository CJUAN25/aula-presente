          && (count <= 4 || validAttendanceRecordSegment(segments[4])
          && (count <= 5 || validAttendanceRecordSegment(segments[5])
          && (count <= 6 || validAttendanceRecordSegment(segments[6])
          && (count <= 7 || validAttendanceRecordSegment(segments[7])
          && (count <= 8 || validAttendanceRecordSegment(segments[8])
          && (count <= 9 || validAttendanceRecordSegment(segments[9])
          && (count <= 10 || validAttendanceRecordSegment(segments[10])
