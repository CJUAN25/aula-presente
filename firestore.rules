      match /weekly_blocks/{blockId} {
        allow get: if canReadCourseBlock(courseId, blockId);
        allow list: if canListCourseBlocks(courseId);
        allow create: if validCourseBlockCreate(
          courseId,
          blockId,
          request.resource.data
        );
        allow update, delete: if false;
      }

      match /attendance_requests/{requestId} {
        allow get: if ownAttendanceRequestId(courseId, requestId) || ownsExistingCourse(courseId);
        allow list: if ownsExistingCourse(courseId);
        allow create: if ownAttendanceRequestId(courseId, requestId) && validAttendanceRequest(courseId, requestId, request.resource.data);
        allow update: if canDecideAttendanceRequest(courseId, resource.data, request.resource.data);
        allow delete: if false;
      }

      match /attendance_config/{configId} {
        allow get: if configId == 'current'
          && canGetAttendanceConfig(courseId);
        allow list: if false;
        allow create: if canCreateAttendanceConfig(courseId, configId);
        allow update: if canChangeAttendanceConfig(courseId, configId)
          || canIncrementAttendanceSessionCount(courseId, configId);
        allow delete: if false;
      }

      match /student_calendar/{occurrenceId} {
        allow get, list: if ownsExistingCourse(courseId)
          || studentEnrolledInCourse(courseId);
        allow create, update: if canWriteStudentCalendar(courseId, occurrenceId);
        allow delete: if false;
      }

      match /attendance_calendar/{occurrenceId} {
        allow get, list: if ownsExistingCourse(courseId);
        allow create: if canCreateAttendanceCalendarChange(courseId, occurrenceId);
        allow update: if canUpdateAttendanceCalendarChange(courseId, occurrenceId);
        allow delete: if false;
        match /events/{versionId} {
          allow get, list: if ownsExistingCourse(courseId);
          allow create: if ownsExistingCourse(courseId)
            && request.resource.data.keys().hasOnly(['oldValue','newValue','changedAt','changedBy'])
            && request.resource.data.changedAt == request.time && request.resource.data.changedBy == request.auth.uid
            && getAfter(/databases/$(database)/documents/courses/$(courseId)/attendance_calendar/$(occurrenceId)).data == request.resource.data.newValue
            && getAfter(/databases/$(database)/documents/courses/$(courseId)/attendance_calendar/$(occurrenceId)).data.updatedAt == request.time
            && (exists(/databases/$(database)/documents/courses/$(courseId)/attendance_calendar/$(occurrenceId))
              ? request.resource.data.oldValue == get(/databases/$(database)/documents/courses/$(courseId)/attendance_calendar/$(occurrenceId)).data
              : request.resource.data.oldValue == {});
          allow update, delete: if false;
        }

      }

      match /attendance_sessions/{occurrenceId} {
        allow get, list: if ownsExistingCourse(courseId);
        allow create: if canCreateAttendanceSession(courseId, occurrenceId);
        allow update: if canUpdateAttendanceSession(courseId, occurrenceId);
        allow delete: if false;

        match /segments/{segmentId} {
          allow get, list: if ownsExistingCourse(courseId);
          allow create: if canCreateAttendanceSegment(
            courseId,
            occurrenceId,
            segmentId
          );
          allow update, delete: if false;
        }

        match /roster/{rosterEntryId} {
          allow get, list: if ownsExistingCourse(courseId);
          allow create: if canCreateAttendanceRosterEntry(
            courseId,
            occurrenceId,
            rosterEntryId
          );
          allow update: if canUpdateAttendanceRosterEntry(
            courseId,
            occurrenceId,
            rosterEntryId
          );
          allow delete: if canDeleteAttendanceRosterEntry(
            courseId,
            occurrenceId,
            rosterEntryId
          );
        }

        match /events/{eventId} {
          allow get, list: if ownsExistingCourse(courseId);
          allow create: if canCreateAttendanceEvent(
            courseId,
            occurrenceId,
            eventId
          );
          allow update, delete: if false;
        }
      }

      match /attendance_records/{recordId} {
        allow get: if ownsExistingCourse(courseId)
          || studentCanReadAttendanceRecord(courseId, recordId);
        allow list: if ownsExistingCourse(courseId)
          || studentCanListAttendanceRecords(courseId);
        allow create: if canCreateAttendanceRecord(courseId, recordId);
        allow update: if canUpdateAttendanceRecord(courseId, recordId);
        allow delete: if false;
      }

      match /invitation/{invitationId} {
        allow get: if invitationId == 'current'
          && ownsExistingCourse(courseId);
        allow list: if false;
        allow create: if invitationId == 'current'
          && canCreateCurrentInvitation(courseId);
        allow update: if invitationId == 'current'
          && canUpdateCurrentInvitation(courseId);
        allow delete: if false;
      }

      match /pending_enrollments/{emailExact} {
        allow get: if ownsExistingCourse(courseId)
          || (
            validPendingEnrollmentShape(courseId, emailExact, resource.data)
            && pendingStudentMatchesAuth(resource.data)
          );
        allow list: if ownsExistingCourse(courseId)
          || pendingStudentMatchesAuth(resource.data);
        allow create: if canCreatePendingEnrollment(courseId, emailExact);
        allow update: if request.resource.data.lastEventId is string
          && existsAfter(pendingStatusEventPath(
            courseId,
            emailExact,
            request.resource.data.lastEventId
          ))
          && canChangePendingEnrollment(courseId, emailExact);
        allow delete: if false;

        match /status_events/{eventId} {
          allow get, list: if ownsExistingCourse(courseId);
          allow create: if canCreatePendingStatusEvent(
            courseId,
            emailExact,
            eventId
          );
          allow update, delete: if false;
        }
      }

      match /join_requests/{studentUid} {
        allow get: if (verifiedStudent() && request.auth.uid == studentUid)
          || ownsExistingCourse(courseId);
        allow list: if (ownsExistingCourse(courseId)
            && resource.data.status == 'pending')
          || (verifiedStudent()
            && resource.data.studentUid == request.auth.uid);
        allow create: if canCreateJoinRequest(courseId, studentUid);
        allow update: if canDecideJoinRequest(courseId, studentUid);
        allow delete: if false;
      }

      match /enrollments/{studentUid} {
        allow get: if ownsExistingCourse(courseId)
          || (verifiedStudent() && request.auth.uid == studentUid);
        allow list: if ownsExistingCourse(courseId);
        allow create: if canCreateEnrollment(courseId, studentUid);
        allow update: if canChangeEnrollmentStatus(courseId, studentUid);
        allow delete: if false;

        match /status_events/{eventId} {
          allow get, list: if ownsExistingCourse(courseId);
          allow create: if canCreateEnrollmentStatusEvent(
            courseId,
            studentUid,
            eventId
          );
          allow update, delete: if false;
        }
      }
    }

    match /course_invites/{code} {
      // Code lookup is an exact get for a verified student. The index only
      // exposes a minimal course preview while its code is current and valid.
      allow get: if canReadCurrentCourseInvite(code, resource.data.courseId);
      allow list: if false;
      allow create: if canCreateCourseInvite(code);
      allow update, delete: if false;
    }

    // Collection-group query for the authenticated student's own courses.
    // The query must constrain studentUid to the current UID; other groups
    // and unfiltered enumeration remain denied.
    match /{path=**}/enrollments/{enrollmentId} {
      allow list: if verifiedStudent()
        && resource.data.studentUid == request.auth.uid
        && resource.data.status == 'active';
    }

    // A collection-group query must filter by the authenticated student's UID.
    match /{path=**}/join_requests/{requestId} {
      allow list: if verifiedStudent()
        && resource.data.studentUid == request.auth.uid;
    }

    // A collection-group query for the authenticated student's own approved
    // records must constrain the exact Auth email, profile code and pending state.
    match /{path=**}/pending_enrollments/{emailExact} {
      allow list: if pendingStudentMatchesAuth(resource.data);
    }
  }
}
