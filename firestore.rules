          && (count <= 13 || validAttendanceRecordSegment(segments[13])
          && (count <= 14 || validAttendanceRecordSegment(segments[14])
          && (count <= 15 || validAttendanceRecordSegment(segments[15])
          && (count <= 16 || validAttendanceRecordSegment(segments[16])
          && (count <= 17 || validAttendanceRecordSegment(segments[17])
          && (count <= 18 || validAttendanceRecordSegment(segments[18])
          && (count <= 19 || validAttendanceRecordSegment(segments[19])
          && (count <= 20 || validAttendanceRecordSegment(segments[20])
