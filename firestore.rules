    match /courses/{courseId} {
      allow get: if canGetCourse(courseId);
      allow list: if verifiedTeacher()
        && resource.data.ownerUid == request.auth.uid;

      allow create: if verifiedTeacher()
        && validCourseShape(courseId, request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid
