      let session = get(attendanceSessionPath(courseId, data.sessionId)).data;
      return data.keys().hasAll(['sessionId','rosterEntryId','studentUid','segmentId','text','status','createdAt','decidedAt','decidedBy','eventId'])
        && data.keys().hasOnly(['sessionId','rosterEntryId','studentUid','segmentId','text','status','createdAt','decidedAt','decidedBy','eventId'])
        && data.studentUid == request.auth.uid && data.rosterEntryId == studentAttendanceRosterId(courseId)
        && requestId == data.sessionId + '|' + data.rosterEntryId + '|' + (data.segmentId == null ? 'meeting' : data.segmentId)
        && data.text is string && data.text.size() > 0 && data.text.size() <= 500
        && data.status == 'pending' && data.createdAt == request.time
        && data.decidedAt == null && data.decidedBy == null && data.eventId == null
