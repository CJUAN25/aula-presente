# Private credentials (Firebase client configuration is versioned)
.env
.env.*
!.env.example
key.properties
*.jks
*.keystore
*.p12
*.p8
*.pem
service-account*.json
firebase-adminsdk*.json

# Apple client configuration is not part of the configured Android delivery
/ios/Runner/GoogleService-Info.plist

# Historical documentation archive; the Flutter project is the deliverable
/insumos_codigo_aula_presente.zip

# Private evidence screenshots
/docs/evidencias/privadas/
*.sensitive.png
